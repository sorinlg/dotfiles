################################################
#  Custom Completion-Only Registration         #
################################################
# Register a tool with custom completion function WITHOUT creating a command wrapper
# This allows 'command -v' to find the real binary (important for IDE integration)
#
# Usage: _register_completion_only_custom "tool_name" "init_function"
#   tool_name: Name of the tool
#   init_function: Function to call for initialization (should set up completion)
#
# Example: _register_completion_only_custom "aws" "_aws_completion_init"
_register_completion_only_custom() {
    local tool_name="$1"
    local init_function="$2"

    if [[ -z "$tool_name" || -z "$init_function" ]]; then
        echo "Error: tool_name and init_function are required" >&2
        return 1
    fi

    # Create lazy init wrapper using eval (more compatible)
    eval "_${tool_name}_compl_lazy_init() {
        [[ -n \$_COMPLETION_LOADED[$tool_name] ]] && return
        _COMPLETION_LOADED[$tool_name]=1

        if declare -f $init_function >/dev/null 2>&1; then
            $init_function
        fi
    }"

    # Create completion wrapper that triggers lazy loading
    # NOTE: No command wrapper is created - tool remains discoverable in PATH
    eval "_${tool_name}_completion() {
        _${tool_name}_compl_lazy_init
        # Completion is handled by the init_function setup
    }"

    # Register completion function (no command wrapper)
    compdef _${tool_name}_completion $tool_name 2>/dev/null
}

################################################
#  Custom Completion Registration               #
################################################
# Register a tool with custom completion function (for complex cases)
# Usage: _register_lazy_completion_custom "tool_name" "init_function" "completion_function" ["tool_command"]
#   tool_name: Name of the tool
#   init_function: Function to call for initialization
#   completion_function: Function to call for completion
#   tool_command: Actual command name (defaults to tool_name)
#
# Example: _register_lazy_completion_custom "awss" "_awss_init" "_awss_completion"
#
# DEPRECATED: This function creates command wrappers that shadow real binaries.
# Use _register_completion_only_custom for tools that only need completion loading.
_register_lazy_completion_custom() {
    local tool_name="$1"
    local init_function="$2"
    local completion_function="$3"
    local tool_command="${4:-$tool_name}"

    if [[ -z "$tool_name" || -z "$init_function" || -z "$completion_function" ]]; then
        echo "Error: tool_name, init_function, and completion_function are required" >&2
        return 1
    fi

    # Create lazy init wrapper using eval (more compatible)
    eval "_${tool_name}_lazy_init() {
        [[ -n \$_COMPLETION_LOADED[$tool_name] ]] && return
        _COMPLETION_LOADED[$tool_name]=1

        if declare -f $init_function >/dev/null 2>&1; then
            $init_function
        fi
    }"

    # Create completion wrapper that triggers lazy loading
    eval "_${tool_name}_completion_wrapper() {
        _${tool_name}_lazy_init
        if declare -f $completion_function >/dev/null 2>&1; then
            $completion_function \"\$@\"
        else
            _default
        fi
    }"

    # Create command wrapper that triggers lazy loading
