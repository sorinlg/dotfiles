    }"

    # Register completion function
    compdef _${tool_name}_completion_wrapper $tool_name 2>/dev/null
}

################################################
#  Grouped Completion Registration             #
################################################
# Register multiple related tools with a shared lazy init function
# Usage: _register_lazy_completion_group "group_name" "init_function" "tool1:completion1" "tool2:completion2" ...
#   group_name: Name of the group (for state tracking)
#   init_function: Single function to call for initialization
#   tool entries: "tool_name:completion_function" pairs
#
# Example: _register_lazy_completion_group "k8s" "_k8s_init" "kubectl:_kubectl" "helm:_helm" "k9s:_k9s"
_register_lazy_completion_group() {
    local group_name="$1"
    local init_function="$2"
    shift 2

    if [[ -z "$group_name" || -z "$init_function" ]]; then
        echo "Error: group_name and init_function are required" >&2
        return 1
    fi

    # Create shared lazy init function
    eval "_${group_name}_lazy_init() {
        [[ -n \$_COMPLETION_LOADED[$group_name] ]] && return
        _COMPLETION_LOADED[$group_name]=1

        if declare -f $init_function >/dev/null 2>&1; then
            $init_function
        fi
    }"

    # Process each tool in the group
    local tool_entry
    for tool_entry in "$@"; do
        local tool_name="${tool_entry%%:*}"
        local completion_func="${tool_entry##*:}"

        if [[ -n "$tool_name" && -n "$completion_func" ]]; then
            # Create completion wrapper for this tool
            eval "_${tool_name}_completion() {
                _${group_name}_lazy_init
                if (( \$+functions[$completion_func] )); then
                    $completion_func \"\$@\"
                else
                    _default
                fi
            }"

            # Create command wrapper
            eval "$tool_name() {
                _${group_name}_lazy_init
                command $tool_name \"\$@\"
            }"

            # Register completion
            compdef _${tool_name}_completion $tool_name 2>/dev/null
        fi
    done
}

################################################
#  Utility Functions                           #
################################################
# Check if a completion is loaded
_is_completion_loaded() {
    local tool_name="$1"
    [[ -n "${_COMPLETION_LOADED[$tool_name]}" ]]
}

# Force reload a completion (for debugging)
_reload_completion() {
    local tool_name="$1"
    unset "_COMPLETION_LOADED[$tool_name]"
    if declare -f "_${tool_name}_lazy_init" >/dev/null 2>&1; then
        _${tool_name}_lazy_init
    fi
}

# List all registered completions and their status
_list_completions() {
    echo "Registered lazy completions:"
    for tool in "${(@k)_COMPLETION_LOADED}"; do
        local status="${_COMPLETION_LOADED[$tool]:+loaded}"
        status="${status:-not loaded}"
        echo "  $tool: $status"
    done
}