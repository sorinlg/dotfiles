################################################
#  Bash Completion-Only Registration           #
################################################
# Register a tool for lazy-loaded Bash completion WITHOUT creating a command wrapper
# This allows 'command -v' to find the real binary (important for IDE integration)
#
# Usage: _register_completion_only_bash "tool_name" ["tool_command"] ["completion_args"]
#   tool_name: Name of the tool
#   tool_command: Actual command name (defaults to tool_name)
#   completion_args: Arguments for complete command (defaults to "-o nospace -C $tool_command")
#
# Example: _register_completion_only_bash "terraform"
_register_completion_only_bash() {
    local tool_name="$1"
    local tool_command="${2:-$tool_name}"
    local completion_args="${3:--o nospace -C $tool_command}"

    if [[ -z "$tool_name" ]]; then
        echo "Error: tool_name is required" >&2
        return 1
    fi

    # Create lazy init function using eval (more compatible)
    eval "_${tool_name}_compl_lazy_init() {
        [[ -n \$_COMPLETION_LOADED[$tool_name] ]] && return
        _COMPLETION_LOADED[$tool_name]=1

        if command -v $tool_command >/dev/null 2>&1; then
            # Load bash completion for the tool
            autoload -U +X bashcompinit && bashcompinit
            complete $completion_args $tool_command
        fi
    }"

    # Create completion function that triggers lazy loading
    # NOTE: No command wrapper is created - tool remains discoverable in PATH
    eval "_${tool_name}_completion() {
        _${tool_name}_compl_lazy_init
        # Let the tool handle its own completion after init
        local words
        words=(\${(z)BUFFER})
        if [[ \${#words} -gt 1 ]]; then
            # Pass to tool for completion if it supports help
            reply=(\$($tool_command -help \${words[2,-1]} 2>/dev/null | grep -E '^\s+\S+' | awk '{print \$1}' || true))
        fi
    }"

    # Register completion function (no command wrapper)
    compdef _${tool_name}_completion $tool_name 2>/dev/null
}

