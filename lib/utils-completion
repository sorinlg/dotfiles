#!/usr/bin/env zsh

################################################
#  Generic Completion Utilities                #
################################################
# This file provides generic functions for lazy loading completions
# to reduce code duplication and improve maintainability

# Global variable to store completion state
typeset -gA _COMPLETION_LOADED

################################################
#  ZSH Completion Registration (eval-based)    #
################################################
# Register a tool for lazy-loaded ZSH completion
# Usage: _register_lazy_completion_zsh "tool_name" ["tool_command"] ["completion_command"]
#   tool_name: Name of the tool (used for function names and state tracking)
#   tool_command: Actual command name (defaults to tool_name)
#   completion_command: Command to generate completion (defaults to "tool_name completion zsh")
#
# Example: _register_lazy_completion_zsh "kubectl"
# Example: _register_lazy_completion_zsh "k" "kubectl" "kubectl completion zsh"
#
# DEPRECATED: This function creates command wrappers that shadow real binaries.
# Use _register_completion_only_zsh for tools that only need completion loading.
# Use _register_command_wrapper for tools that need environment initialization.
_register_lazy_completion_zsh() {
    local tool_name="$1"
    local tool_command="${2:-$tool_name}"
    local completion_command="${3:-$tool_name completion zsh}"

    if [[ -z "$tool_name" ]]; then
        echo "Error: tool_name is required" >&2
        return 1
    fi

    # Create lazy init function using eval (more compatible)
    eval "_${tool_name}_lazy_init() {
        [[ -n \$_COMPLETION_LOADED[$tool_name] ]] && return
        _COMPLETION_LOADED[$tool_name]=1

        if command -v $tool_command >/dev/null 2>&1; then
            eval \"\$($completion_command 2>/dev/null)\" 2>/dev/null || true
        fi
    }"

    # Create completion function that triggers lazy loading
    eval "_${tool_name}_completion() {
        _${tool_name}_lazy_init
        if (( \$+functions[_$tool_command] )); then
            _$tool_command \"\$@\"
        else
            _default
        fi
    }"

    # Create wrapper function that triggers lazy loading
    eval "$tool_name() {
        _${tool_name}_lazy_init
        command $tool_command \"\$@\"
    }"

    # Register completion function
    compdef _${tool_name}_completion $tool_name 2>/dev/null
}

