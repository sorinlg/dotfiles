#!/usr/bin/env zsh
################################################
#  zsh-completion                              #
################################################
# Optimized completion loading - avoid multiple compinit calls and security checks
autoload -Uz compinit

# Always skip security check for maximum speed
# Only regenerate dump if it doesn't exist or is older than 24 hours
if [[ ! -f ~/.zcompdump || -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit -C
else
    compinit -C -d ~/.zcompdump
fi

################################################
#  vim                                         #
################################################
# Cache editor path using ZSH builtin
export EDITOR="${commands[vim]:-vim}"
