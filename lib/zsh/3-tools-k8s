################################################
# ## kubectx
# alias ks='kubectx'

# ## clear k8s environment variables
kc() {
  kubectx -u &> /dev/null
  unset KUBECONFIG
}
export kc >/dev/null

## kubeswitch - lazy loading for faster startup
_kubeswitch_lazy_init() {
  [[ -n $_kubeswitch_lazy_loaded ]] && return
  _kubeswitch_lazy_loaded=1

  if (( $+commands[switcher] )); then
    source <(switcher init zsh)
    source <(switch completion zsh)
  fi
}

# Wrapper for switch command to ensure lazy loading
switch() {
  _kubeswitch_lazy_init
  command switch "$@"
}

# ks function that uses switch set-context
ks() {
  _kubeswitch_lazy_init
  switch set-context "$@"
}

# Set up completion for ks to work like switch set-context (deferred)
_ks_completion() {
  _kubeswitch_lazy_init

  if (( $+functions[_switch] )); then
    # Temporarily modify the words array to make it look like "switch set-context ..."
    local original_words=("${words[@]}")
    local original_current=$CURRENT

    words=(switch set-context "${original_words[@]:1}")
    CURRENT=$((original_current + 1))

    _switch

    # Restore original context
    words=("${original_words[@]}")
    CURRENT=$original_current
  fi
}

compdef _ks_completion ks

